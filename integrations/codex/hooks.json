{
  "description": "Record native Codex file patches in the local aimark ledger.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "aimark hook codex", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "aimark hook codex", "timeout": 30 }
        ]
      }
    ]
  }
}
